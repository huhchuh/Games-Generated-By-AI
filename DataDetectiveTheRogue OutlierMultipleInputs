<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Data Detective: The Rogue Outlier</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-correct: #10b981;
            --accent-error: #ef4444;
            --accent-blue: #3b82f6;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            overflow: hidden;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* 75vh / 25vh Viewport Boundaries Split */
        #game-area {
            height: 75vh;
            padding: 15px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow-y: auto;
        }

        #footer-controls {
            height: 25vh;
            background-color: var(--card-bg);
            border-top: 2px solid #334155;
            padding: 12px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            z-index: 10;
        }

        /* Typography & Layout elements */
        .header-ui {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .score-box { font-size: 1.2rem; font-weight: bold; color: var(--accent-blue); }
        .timer-box { font-size: 1.2rem; font-weight: bold; color: var(--accent-error); }

        #stream-container {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 10px;
            justify-content: center;
        }

        /* Accessible Touch Safety Targets (min-height standard 55px) */
        .data-row {
            background-color: #273549;
            border: 2px solid #475569;
            border-radius: 8px;
            min-height: 58px;
            padding: 10px 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-family: "Courier New", Courier, monospace;
            font-size: 0.9rem;
            cursor: pointer;
            transition: background-color 0.2s;
            touch-action: manipulation;
        }

        .data-row:active {
            background-color: #334155;
        }

        /* Custom Data Modification Drawer */
        #config-drawer {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 75vh;
            background-color: var(--bg-color);
            z-index: 20;
            padding: 20px;
            display: none;
            flex-direction: column;
            gap: 10px;
            border-bottom: 2px solid var(--accent-blue);
        }

        textarea {
            width: 100%;
            flex-grow: 1;
            background-color: #1e293b;
            color: #38bdf8;
            border: 1px solid #475569;
            padding: 10px;
            font-family: monospace;
            border-radius: 6px;
            resize: none;
        }

        .btn {
            background-color: var(--accent-blue);
            color: white;
            border: none;
            border-radius: 6px;
            min-height: 48px;
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-secondary { background-color: #475569; }
        .btn-success { background-color: var(--accent-correct); }

        /* Screen Reader Accessible Layer */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            border: 0;
        }
    </style>
</head>
<body>

    <div id="accessibility-announcer" class="sr-only" aria-live="polite"></div>

    <main id="game-area">
        <div class="header-ui">
            <div class="score-box">Score: <span id="score-val">0</span></div>
            <div id="data-source-indicator" style="font-size: 0.8rem; color: var(--text-muted)">Source: Dynamic Telemetry</div>
            <div class="timer-box">Time: <span id="timer-val">10.0</span>s</div>
        </div>

        <div id="stream-container">
            </div>
    </main>

    <section id="config-drawer">
        <h3>Data Ingestion Engine</h3>
        <p style="font-size: 0.85rem; color: var(--text-muted);">
            Paste raw text rows, CSV chunks, or JSON objects below. The system will auto-extract patterns to generate anomalies.
        </p>
        <textarea id="data-input" placeholder='Example CSV Format:&#10;temperature, humidity&#10;22.5, 45&#10;23.1, 46&#10;99.9, 44 (Outlier!)'></textarea>
        <div style="display: flex; gap: 10px;">
            <button class="btn btn-secondary" style="flex: 1;" onclick="toggleConfig()">Cancel</button>
            <button class="btn btn-success" style="flex: 1;" onclick="loadCustomData()">Inject & Parse Data</button>
        </div>
    </section>

    <footer id="footer-controls">
        <p id="status-update" style="text-align: center; font-size: 0.9rem; color: var(--text-muted);">
            Find the line item that contains the Rogue Outlier anomaly!
        </p>
        <div style="display: flex; gap: 10px;">
            <button class="btn btn-secondary" style="flex: 1;" onclick="toggleConfig()">⚙️ Connect Source Data</button>
            <button class="btn" style="flex: 1;" id="action-btn" onclick="initGame()">Start Game</button>
        </div>
    </footer>

    <script>
        // Internal state variables 
        let score = 0;
        let timeLeft = 10.0;
        let gameInterval = null;
        let isGameActive = false;
        let currentOutlierIndex = null;
        let baseTimeLimit = 10.0;

        // Default local operational model structure
        let internalDataset = [
            { label: "SYS_NODE_01", value: 24.5 },
            { label: "SYS_NODE_02", value: 25.1 },
            { label: "SYS_NODE_03", value: 23.9 },
            { label: "SYS_NODE_04", value: 24.8 },
            { label: "SYS_NODE_05", value: 25.3 }
        ];
        let useDynamicGeneration = true;

        const announcer = document.getElementById("accessibility-announcer");
        const streamContainer = document.getElementById("stream-container");
        const scoreVal = document.getElementById("score-val");
        const timerVal = document.getElementById("timer-val");
        const statusUpdate = document.getElementById("status-update");
        const actionBtn = document.getElementById("action-btn");

        function announce(text) {
            announcer.textContent = text;
        }

        function toggleConfig() {
            const drawer = document.getElementById("config-drawer");
            drawer.style.display = drawer.style.display === "flex" ? "none" : "flex";
        }

        // The Ingestion & Formatting Parser Layer
        function loadCustomData() {
            const rawText = document.getElementById("data-input").value.trim();
            if (!rawText) {
                alert("Please enter some messy data strings to parse!");
                return;
            }

            try {
                let parsedRows = [];
                // Check if JSON configuration
                if (rawText.startsWith("[") || rawText.startsWith("{")) {
                    const cleanObj = JSON.parse(rawText);
                    const arr = Array.isArray(cleanObj) ? cleanObj : [cleanObj];
                    arr.forEach((item, idx) => {
                        let values = Object.values(item).filter(v => typeof v === 'number');
                        if (values.length > 0) {
                            parsedRows.push({ label: `ROW_${idx}`, value: values[0] });
                        }
                    });
                } else {
                    // Raw Comma/Newline Separated Log Parsing Strings
                    const lines = rawText.split("\n");
                    lines.forEach((line, idx) => {
                        if (!line.trim()) return;
                        const segments = line.split(/[\t,;]+/);
                        for (let segment of segments) {
                            let num = parseFloat(segment.trim());
                            if (!isNaN(num)) {
                                parsedRows.push({ label: `LINE_${idx + 1}`, value: num });
                                break;
                            }
                        }
                    });
                }

                if (parsedRows.length < 3) {
                    alert("Parsed data array is too short! Include at least 3 valid numerical lines.");
                    return;
                }

                internalDataset = parsedRows;
                useDynamicGeneration = false;
                document.getElementById("data-source-indicator").textContent = "Source: Ingested Custom Data";
                statusUpdate.textContent = `Successfully parsed ${parsedRows.length} data rows!`;
                toggleConfig();
                initGame();
            } catch (e) {
                alert("Formatting Engine Error parsing inputs. Check standard CSV delimiters or raw numbers.");
            }
        }

        // Logic processing pipeline maps and sets up a new random round
        function generateRound() {
            streamContainer.innerHTML = "";
            let roundItems = [];

            if (useDynamicGeneration) {
                // Generate messy system metric variations natively 
                let baseline = 100 + Math.random() * 500;
                let variance = baseline * 0.05; 
                let outlierMultiplier = Math.random() > 0.5 ? 2.5 : 0.2;

                let rowCount = 4;
                currentOutlierIndex = Math.floor(Math.random() * rowCount);

                for (let i = 0; i < rowCount; i++) {
                    if (i === currentOutlierIndex) {
                        roundItems.push({
                            label: `METRIC_TRC_0${i+1}`,
                            value: Math.round(baseline * outlierMultiplier)
                        });
                    } else {
                        roundItems.push({
                            label: `METRIC_TRC_0${i+1}`,
                            value: Math.round(baseline + (Math.random() * variance * 2 - variance))
                        });
                    }
                }
            } else {
                // Use imported data structures to determine outliers
                let itemPool = [...internalDataset];
                let selectedRows = [];
                
                // Pull a subset slice of rows to present on mobile viewport boundaries
                let displayCount = Math.min(4, itemPool.length);
                for(let i=0; i < displayCount; i++) {
                    let randIndex = Math.floor(Math.random() * itemPool.length);
                    selectedRows.push(itemPool.splice(randIndex, 1)[0]);
                }

                // Mathematical Mean Strategy to identify natural structural variance
                let values = selectedRows.map(r => r.value);
                let mean = values.reduce((a, b) => a + b, 0) / values.length;
                let deviations = selectedRows.map(r => Math.abs(r.value - mean));
                let maxDevIdx = deviations.indexOf(Math.max(...deviations));

                currentOutlierIndex = maxDevIdx;
                roundItems = selectedRows;
            }

            // Building HTML layouts securely with access dimensions
            roundItems.forEach((item, index) => {
                const element = document.createElement("div");
                element.className = "data-row";
                element.setAttribute("role", "button");
                element.setAttribute("tabindex", "0");
                element.innerHTML = `<span>⚙️ [${item.label}]</span> <strong>${item.value}</strong>`;
                
                element.onclick = () => handleTap(index);
                streamContainer.appendChild(element);
            });

            announce(`New data level generated. 4 lines available. Spot the statistical variance anomaly.`);
        }

        function handleTap(selectedIndex) {
            if (!isGameActive) return;

            if (selectedIndex === currentOutlierIndex) {
                score++;
                scoreVal.textContent = score;
                statusUpdate.textContent = "✅ Correct! Noise filtered out successfully.";
                statusUpdate.style.color = "var(--accent-correct)";
                
                // Progression curve updates speed as score points climb
                baseTimeLimit = Math.max(3.0, 10.0 - (score * 0.6));
                timeLeft = baseTimeLimit;
                
                generateRound();
            } else {
                endGame(false);
            }
        }

        function initGame() {
            score = 0;
            baseTimeLimit = 10.0;
            timeLeft = baseTimeLimit;
            scoreVal.textContent = score;
            isGameActive = true;
            actionBtn.textContent = "Restart Game";
            statusUpdate.textContent = "Data pipeline scanning live... Spot the rogue trend element!";
            statusUpdate.style.color = "var(--text-muted)";
            
            if (gameInterval) clearInterval(gameInterval);
            generateRound();
            
            gameInterval = setInterval(() => {
                timeLeft -= 0.1;
                timerVal.textContent = timeLeft.toFixed(1);
                if (timeLeft <= 0) {
                    endGame(true);
                }
            }, 100);
        }

        function endGame(isTimeout) {
            isGameActive = false;
            clearInterval(gameInterval);
            timerVal.textContent = "0.0";
            
            const reason = isTimeout ? "Pipeline Timeout Error!" : "False Validation Error (Picked Clean Data Entry)!";
            statusUpdate.textContent = `❌ Game Over: ${reason} Final Score: ${score}`;
            statusUpdate.style.color = "var(--accent-error)";
            actionBtn.textContent = "Play Again";
            
            announce(`Game over. ${reason}. Your absolute validation score was ${score} entries checked.`);
        }
    </script>
</body>
</html>
